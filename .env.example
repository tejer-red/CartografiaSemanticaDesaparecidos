# .env.example - Configuración Integral para Cartografía Semántica de Desaparecidos

# -------------------------------------------------
# Configuración del Entorno y Depuración
# -------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# -------------------------------------------------
# Criptografía PII (Anonimizador y Hashes Deterministas)
# -------------------------------------------------
# Sal compartida para generar hashes consistentes entre organizaciones aliadas
PII_GLOBAL_SALT=tejer_secret_salt_2026_cartografia_semantica

# -------------------------------------------------
# Base de Datos PostgreSQL Dedicada (Servidor abeja:5432 o local)
# -------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=tejer_Admin
DB_PASSWORD=secret_postgres_password
DB_NAME=cartografia_semantica_db
DATABASE_URL=postgresql://tejer_Admin:secret_postgres_password@127.0.0.1:5432/cartografia_semantica_db

# -------------------------------------------------
# Base Vectorial Qdrant (Servidor abeja:6333 o local)
# -------------------------------------------------
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_COLLECTION=cartografia_registros_anonimizados

# -------------------------------------------------
# Broker de Colas Redis (Servidor abeja:6379 o local)
# -------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_QUEUE_OSINT=cola_mineria_osint

# -------------------------------------------------
# Metabuscador Privado SearXNG (Descubrimiento de Noticias)
# -------------------------------------------------
SEARXNG_URL=http://127.0.0.1:8888

# -------------------------------------------------
# Motor de Inferencia LLM vLLM (Servidor GPU en Red Local)
# -------------------------------------------------
VLLM_API_BASE=https://ia-pub.tejer.red/api/v1
VLLM_MODEL=architect:latest
VLLM_API_KEY=none

# -------------------------------------------------
# Concurrencia de Minería y Protección de Hardware Edge
# -------------------------------------------------
# En Raspberry Pi 3B+ (1GB RAM) ajustar estrictamente a 1. En servidores ajustar a 4-10.
PLAYWRIGHT_CONCURRENCY=1
OSINT_RATE_LIMIT_SECONDS=300

# -------------------------------------------------
# Geocodificación y Servicios Externos
# -------------------------------------------------
LOCATIONIQ_API_KEY=tu_token_locationiq_aqui
SUPABASE_DATABASE_URL=postgresql://usuario:contrasena@tu-host.supabase.co:5432/postgres
